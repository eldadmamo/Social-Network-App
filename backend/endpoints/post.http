@baseUrl = http://localhost:5000
@urlPath = api/v1


###

POST {{baseUrl}}/{{urlPath}}/post
Content-Type: application/json
Accept: application/json
withCredentials: true

{
  "post": "This is my regular post",
  "bgColor": "#41aa1f3",
  "privacy": "Public",
  "gifUrl": "",
